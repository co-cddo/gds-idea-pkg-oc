// GDS IDEA team preferred OpenCode config.
// Copy this to ~/.config/opencode/opencode.jsonc as a starting point.
// Models are reached through a Bedrock inference profile, one per team, so usage is tracked per team.
// This file uses the ds profile. If you are in sds or econ, run `idea-oc sync config --team <name>` instead.
// It needs prompts/idea-oc-anthropic.txt beside it (see the agent settings below), and `idea-oc sync config`
// puts both in place, so prefer that to copying this file.
// Setup guide: https://co-cddo.github.io/gds-idea-pkg-oc/guides/setup/
// "./plugin-scripts/inject-env.js" is the REQUIRED plugin script; see the plugins guide:
// https://co-cddo.github.io/gds-idea-pkg-oc/guides/plugins/
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-west-2",
        "profile": "bedrockonly"
      },
      //OpenCode cannot tell what a model can do from a profile's ARN, so its settings are restated here.
      //The key must contain "claude" and "anthropic", or OpenCode stops caching prompts.
      "models": {
        "anthropic-claude-sonnet-5-5-ds": {
          "id": "arn:aws:bedrock:eu-west-2:992382722318:application-inference-profile/4niqtfvd2b0y",
          "name": "Claude Sonnet 5.5 (ds)",
          "family": "claude-sonnet",
          "release_date": "2026-09-28",
          //false on purpose: with true OpenCode adds Amazon Nova style reasoning settings that Bedrock rejects for Claude.
          //The levels below are still offered, written as the raw fields Claude expects.
          "reasoning": false,
          "tool_call": true,
          "attachment": true,
          "temperature": false,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 2.2, "output": 11.0, "cache_read": 0.22, "cache_write": 2.75 },
          "variants": {
            "low": { "additionalModelRequestFields": { "thinking": { "type": "adaptive", "display": "summarized" }, "output_config": { "effort": "low" } } },
            "medium": { "additionalModelRequestFields": { "thinking": { "type": "adaptive", "display": "summarized" }, "output_config": { "effort": "medium" } } },
            "high": { "additionalModelRequestFields": { "thinking": { "type": "adaptive", "display": "summarized" }, "output_config": { "effort": "high" } } },
            "xhigh": { "additionalModelRequestFields": { "thinking": { "type": "adaptive", "display": "summarized" }, "output_config": { "effort": "xhigh" } } },
            "max": { "additionalModelRequestFields": { "thinking": { "type": "adaptive", "display": "summarized" }, "output_config": { "effort": "max" } } }
          }
        }
      }
    }
  },
  "model": "amazon-bedrock/anthropic-claude-sonnet-5-5-ds",
  //OpenCode picks its instructions from the model id, and an ARN does not say the model is Claude.
  //These point the agents at a copy of the Claude instructions: save prompts/idea-oc-anthropic.txt next to this file.
  //Without that file OpenCode will not start.
  "agent": {
    "build": { "prompt": "{file:./prompts/idea-oc-anthropic.txt}" },
    "plan": { "prompt": "{file:./prompts/idea-oc-anthropic.txt}" },
    "general": { "prompt": "{file:./prompts/idea-oc-anthropic.txt}" }
  },
  "disabled_providers": ["anthropic"],
  "plugin": [
    ["./plugin-scripts/inject-env.js", { "AWS_PROFILE": "bedrockonly" }],
    "@tarquinen/opencode-dcp@latest",
    "envsitter-guard",
    "opencode-snip",
    "cc-safety-net"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "cdk deploy*": "ask", //Stop AI deploying whatever it wants
      "cdk destroy*": "deny", //Stop AI destroying without review
      "git push *": "ask", //Confirm before any push to a remote, including a force-push after a rebase
      "git reset --hard*": "deny", //Stop AI resetting your local repo
      "rm -rf*": "deny", //Stop AI deleting files without warning
      "sudo *": "ask", //Require a check before AI gets elevated privileges
      "gh pr *": "ask", //Default: confirm before any PR action
      "gh pr create *": "deny", //Blocks creating a non-draft PR outright
      "gh pr create --draft*": "ask", //Draft PRs are the only kind the agent can open, and still requires confirmation
      "gh pr merge *": "deny", //Merging is annoying to undo — blocked outright
      "gh pr ready *": "deny", //Blocks taking a PR out of draft — review still required before a PR goes live
      "gh pr close *": "ask" //Confirm before closing a PR
    },
    "external_directory": {
      "*": "ask" //Pause before AI reads/writes anything outside this project
    },
    "edit": {
      "*": "ask" //Show every file write before it happens, so nothing lands without a look
    }
  }
}
